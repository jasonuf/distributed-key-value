<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.jason.dkv</groupId>
    <artifactId>dkv-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>acceptance</artifactId>
  <description>Stage acceptance tests (black-box). Run with ./mvnw verify -Dstage=N.</description>

  <properties>
    <!-- Acceptance tests launch whole nodes and clusters, so they may see Ratis transitively. -->
    <dkv.allowRatis>true</dkv.allowRatis>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <!-- Not called directly: tests start kv-server as a separate process (see NodeProcess).
         Depending on it makes Maven build it first and puts it on the node classpath below. -->
    <dependency>
      <groupId>dev.jason.dkv</groupId>
      <artifactId>kv-server</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Computes the classpath for starting a node (kv-server plus its runtime dependencies,
             no test libraries) into the dkv.node.classpath property, passed to the tests below. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>node-classpath</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputProperty>dkv.node.classpath</outputProperty>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- Without these, -Dstage and -Dseed never reach the test JVM and stage selection
               silently does nothing. Stage00WorkbenchIT guards against that. -->
          <systemPropertyVariables>
            <stage>${stage}</stage>
            <seed>${seed}</seed>
            <dkv.node.classpath>${dkv.node.classpath}</dkv.node.classpath>
          </systemPropertyVariables>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
